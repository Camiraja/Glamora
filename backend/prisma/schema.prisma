generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
}

enum BusinessDeliveryMode {
  STUDIO_ONLY
  HOME_SERVICE_ONLY
  BOTH
}

enum AppointmentDeliveryMode {
  STUDIO
  HOME_SERVICE
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentType {
  DEPOSIT
  BALANCE
  PRODUCT_ORDER
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  businesses   Business[]
  staffMembers StaffMember[]
  availability Availability[]
  blockoutDates BlockoutDate[]
  appointmentsAsCustomer Appointment[] @relation("CustomerAppointments")
  appointmentsAsVendor Appointment[] @relation("VendorAppointments")
  payments Payment[]
}

model Business {
  id          String     @id @default(uuid())
  ownerId     String
  name        String
  description String?
  phone       String?
  email       String?
  deliveryMode BusinessDeliveryMode @default(BOTH)
  breakagePercent Int @default(25)
  logisticsFeeKobo Int @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner       User       @relation(fields: [ownerId], references: [id])
  locations   BusinessLocation[]
  services    Service[]
  products    Product[]
  staff       StaffMember[]
  appointments Appointment[]

  @@index([ownerId])
}

model BusinessLocation {
  id         String   @id @default(uuid())
  businessId String
  name       String
  address    String
  city       String
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model StaffMember {
  id         String   @id @default(uuid())
  businessId String
  userId     String?
  name       String
  email      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
  services   Service[]
  availability Availability[]
  blockoutDates BlockoutDate[]
  appointments Appointment[]
  appointmentSlots AppointmentSlot[]

  @@index([businessId])
  @@index([userId])
}

model Availability {
  id            String   @id @default(uuid())
  vendorId      String
  staffMemberId String?
  dayOfWeek     Int
  startTime     String
  endTime       String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendor        User        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([vendorId, dayOfWeek])
  @@index([staffMemberId, dayOfWeek])
}

model BlockoutDate {
  id            String   @id @default(uuid())
  vendorId      String
  staffMemberId String?
  startsAt      DateTime
  endsAt        DateTime
  reason        String?
  createdAt     DateTime @default(now())

  vendor        User        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([vendorId, startsAt, endsAt])
  @@index([staffMemberId, startsAt, endsAt])
}

model ServiceCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  services    Service[]
}

model Service {
  id             String          @id @default(uuid())
  businessId     String
  categoryId     String?
  staffMemberId  String?
  name           String
  description    String?
  durationMin    Int
  priceKobo      Int
  depositPercent Int
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  business       Business        @relation(fields: [businessId], references: [id])
  category       ServiceCategory? @relation(fields: [categoryId], references: [id])
  staffMember    StaffMember?    @relation(fields: [staffMemberId], references: [id])
  images         ServiceImage[]
  appointmentItems AppointmentService[]

  @@index([businessId])
  @@index([categoryId])
  @@index([staffMemberId])
}

model ServiceImage {
  id        String   @id @default(uuid())
  serviceId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model Product {
  id              String        @id @default(uuid())
  businessId      String
  name            String
  category        String
  description     String?
  priceKobo       Int
  discountPercent Int           @default(0)
  stockQuantity   Int           @default(0)
  imageUrl        String?       @db.Text
  status          ProductStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([category])
}

model Appointment {
  id          String            @id @default(uuid())
  customerId  String
  vendorId    String
  businessId  String
  staffMemberId String?
  status      AppointmentStatus @default(PENDING_PAYMENT)
  deliveryMode AppointmentDeliveryMode @default(STUDIO)
  startAt     DateTime
  endAt       DateTime
  subtotalKobo Int
  depositPercent Int
  depositKobo Int
  vatKobo     Int               @default(0)
  logisticsFeeKobo Int          @default(0)
  notes       String?
  cancelledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  customer    User              @relation("CustomerAppointments", fields: [customerId], references: [id])
  vendor      User              @relation("VendorAppointments", fields: [vendorId], references: [id])
  business    Business          @relation(fields: [businessId], references: [id])
  staffMember StaffMember?      @relation(fields: [staffMemberId], references: [id])
  services    AppointmentService[]
  slots       AppointmentSlot[]
  statusHistory AppointmentStatusHistory[]
  payments    Payment[]

  @@index([customerId, startAt])
  @@index([vendorId, startAt])
  @@index([businessId, startAt])
  @@index([status, startAt])
}

model AppointmentService {
  id            String      @id @default(uuid())
  appointmentId String
  serviceId     String
  serviceName   String
  durationMin   Int
  priceKobo     Int
  depositPercent Int
  createdAt     DateTime    @default(now())

  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])

  @@index([appointmentId])
  @@index([serviceId])
}

model AppointmentSlot {
  id            String      @id @default(uuid())
  appointmentId String
  staffMemberId String?
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime    @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id])

  @@unique([staffMemberId, startsAt])
  @@index([appointmentId])
  @@index([startsAt, endsAt])
}

model AppointmentStatusHistory {
  id            String            @id @default(uuid())
  appointmentId String
  status        AppointmentStatus
  note          String?
  createdAt     DateTime          @default(now())

  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

model Payment {
  id                String        @id @default(uuid())
  appointmentId     String?
  userId            String
  type              PaymentType
  status            PaymentStatus @default(INITIALIZED)
  amountKobo        Int
  currency          String        @default("NGN")
  paystackReference String?       @unique
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@index([appointmentId])
  @@index([userId, status])
  @@unique([appointmentId, type])
}
